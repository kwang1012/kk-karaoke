SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_SECRET=YOUR_SPOTIFY_SECRET
REDIS_HOST=localhost
REDIS_PORT=6379
STORAGE_DIR=storage
# The backend starts Redis (Docker container, or a local redis-server) when none is
# reachable on a local REDIS_HOST. Set to 0 to disable.
# REDIS_AUTOSTART=0
# Comma-separated allowed origins for the API (default: any)
# CORS_ORIGINS=http://localhost:5173
# Cloudflare R2 (optional): processed files are stored in the bucket and synced to disk at startup.
# Create an R2 API token with read/write access to the bucket.
# R2_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
