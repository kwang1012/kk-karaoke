# Optional. Songs, albums and playlists come from YouTube Music and need no credentials.
# Only needed to show names for songs queued by older versions (they were stored by Spotify id).
# SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
# SPOTIFY_SECRET=YOUR_SPOTIFY_SECRET
# Optional: a YouTube Music playlist id for "Surprise me" (defaults to the first Chinese shelf).
# YTMUSIC_DEFAULT_PLAYLIST_ID=PLxxxxxxxxxxxxxxxx
REDIS_HOST=localhost
REDIS_PORT=6379
STORAGE_DIR=storage
# The backend starts Redis (Docker container, or a local redis-server) when none is
# reachable on a local REDIS_HOST. Set to 0 to disable.
# REDIS_AUTOSTART=0
# Comma-separated allowed origins for the API (default: any)
# CORS_ORIGINS=http://localhost:5173
# Cloudflare R2 (optional): processed files are stored in the bucket; audio is cached on demand.
# Create an R2 API token with read/write access to the bucket.
# R2_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Shared catalog (Cloudflare D1): configure the same database on every API and worker.
# Custom API token: Account > D1 > Edit, scoped to this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
# Persist outgoing uploads independently of the disposable STORAGE_DIR cache.
DATA_DIR=data

# Host accounts (leave AUTH_REQUIRED off for local development).
# Keep Supabase public sign-ups disabled: users request access in the app instead.
# AUTH_REQUIRED=1
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=  # Legacy HS256 projects only; otherwise JWKS is used.
# Server-only secret for approved account invitations. Never use a VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=
# PUBLIC_APP_URL=https://kkaraoke.app
# Allow PUBLIC_APP_URL/?setup=1 in Supabase Auth redirect URLs and configure email delivery.

# Modal (optional): separate vocals on a cloud GPU. `uv sync --extra modal`, `modal setup`,
# `modal deploy modal_app.py`, then set USE_MODAL=1. In Docker, pass MODAL_TOKEN_ID / MODAL_TOKEN_SECRET.
# USE_MODAL=1
# MODAL_APP_NAME=kkaraoke
# MODAL_GPU=T4,L4   (tried in order)
# MODAL_IDLE_SECONDS=60   (an idle container is billed this long)
# WORKER_CONCURRENCY=3   (Docker worker: songs processed at once. Only with USE_MODAL: each one uses its own
#                         GPU container, and a fallback to this machine's Demucs still runs one at a time)
