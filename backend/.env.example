SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_SECRET=YOUR_SPOTIFY_SECRET
REDIS_HOST=localhost
REDIS_PORT=6379
STORAGE_DIR=storage
# Set to 1 to let the backend start a Redis Docker container if none is reachable
# REDIS_AUTOSTART=1
# Comma-separated allowed origins for the API (default: any)
# CORS_ORIGINS=http://localhost:5173
