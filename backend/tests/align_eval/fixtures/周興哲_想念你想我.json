 {"time": 72.3, "text": "伤害了爱", "end": 75.24, "confidence": 0.0, "anchored": false, "words": []}, {"time": 75.76, "text": "却还奢望重新开始", "end": 78.86, "confidence": 0.0, "anchored": false, "words": []}, {"time": 80.7, "text": "有一招为我", "end": 83.6, "confidence": 0.0, "anchored": false, "words": []}, {"time": 84.32, "text": "只来懂谁爱我", "end": 87.06, "confidence": 0.0, "anchored": false, "words": []}, {"time": 87.66, "text": "离不再远来", "end": 89.98, "confidence": 0.0, "anchored": false, "words": []}, {"time": 89.98, "text": "生命就是漂泊", "end": 92.56, "confidence": 0.0, "anchored": false, "words": []}, {"time": 94.32, "text": "想念你", "end": 96.34, "confidence": 0.0, "anchored": false, "words": []}, {"time": 97.3, "text": "如此诚实", "end": 99.46, "confidence": 0.0, "anchored": false, "words": []}, {"time": 100.64, "text": "相信的人", "end": 102.3, "confidence": 0.0, "anchored": false, "words": []}, {"time": 102.86, "text": "坚持分开", "end": 104.82, "confidence": 0.0, "anchored": false, "words": []}, {"time": 104.82, "text": "谁能坚持", "end": 106.52, "confidence": 0.0, "anchored": false, "words": []}, {"time": 108.0, "text": "不怕你幸福", "end": 111.04, "confidence": 0.0, "anchored": false, "words": []}, {"time": 111.04, "text": "就怕你忘了我", "end": 114.44, "confidence": 0.0, "anchored": false, "words": []}, {"time": 115.06, "text": "心会痛是最好的", "end": 117.98, "confidence": 0.0, "anchored": false, "words": []}, {"time": 117.98, "text": "不再拥有", "end": 119.96, "confidence": 0.0, "anchored": false, "words": []}, {"time": 119.96, "text": "想念你想我", "end": 123.46, "confidence": 0.0, "anchored": false, "words": []}, {"time": 126.84, "text": "想念你想我", "end": 130.22, "confidence": 0.0, "anchored": false, "words": []}, {"time": 135.8, "text": "走你走过", "end": 137.6, "confidence": 0.0, "anchored": false, "words": []}, {"time": 137.6, "text": "等不及而一再解脱", "end": 140.86, "confidence": 0.0, "anchored": false, "words": []}, {"time": 142.8, "text": "仿佛昨天", "end": 144.84, "confidence": 0.0, "anchored": false, "words": []}, {"ti