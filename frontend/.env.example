VITE_API_ADDR=localhost:8000
# Optional: serve the vocal/instrumental stems straight from the public R2 bucket / CDN instead of the API.
# Objects must be <kind>/<id>.mp3 (vocal/, instrumental/) and the bucket needs a CORS rule for this site.
# VITE_AUDIO_BASE_URL=https://audio.example.com
# Public sign-up + Google (see README). Spotify playlist import needs the app's client id.
# VITE_OPEN_SIGNUP=1
# VITE_SPOTIFY_CLIENT_ID=
