{
  "name": "v1-react",
  "version": "0.2.19",
  "private": true,
  "dependencies": {
    "electron-updater": "^6"
  },
  "main": "electron.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:electron": "vite --mode=electron build",
    "electron": "electron .",
    "package-windows": "vite --mode=electron build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "publish-windows": "bash scripts/publish-windows.sh"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.75.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^36.2.0",
    "electron-builder": "^26",
    "electron-packager": "^17.1.2",
    "lucide-react": "^1.59.0",
    "node-vibrant": "^4.0.3",
    "opencc-js": "^1.0.5",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^7.5.3",
    "react-virtuoso": "^4.7.10",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "zustand": "^5.0.4"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "description": "KKaraoke desktop app",
  "author": "KKaraoke",
  "build": {
    "appId": "app.kkaraoke.desktop",
    "productName": "KKaraoke",
    "publish": {
      "provider": "generic",
      "url": "https://updates.kkaraoke.app/windows"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "electron-preload.js",
      "build/**/*",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "KKaraoke-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
