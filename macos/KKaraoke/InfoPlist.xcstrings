    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KKaraoke looks for TVs and speakers on your network that you can play to."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KKaraoke 会在你的网络上查找可以播放的电视和扬声器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KKaraoke 會在你的網路上尋找可以播放的電視與喇叭。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KKaraoke listens to your microphone to score your singing and play your voice through the speakers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KKaraoke 会使用你的麦克风为演唱评分，并将你的声音从扬声器播出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KKaraoke 會使用你的麥克風為演唱評分，並將你的聲音從喇叭播出。"
          }
        }
      }
    }
  },
  "version" : "1.0"
